rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 排行榜：leaderboards/{遊戲}/entries/{玩家}
    match /leaderboards/{gameId}/entries/{playerId} {

      allow read: if true;
      allow delete: if false;

      // 沒有勾選公開資訊時，只允許基本欄位（學校、年齡、縣市、頭像不能寫入）
      function baseKeys() {
        return ['playerId', 'playerName', 'score', 'baseScore', 'timeMs', 'rankKey',
                'mode', 'showInfo', 'updatedAt'];
      }

      function validData() {
        let d = request.resource.data;
        return gameId in ['memory', 'guess', 'mult', 'calc', 'zhuyin', 'whack']
          && d.playerId == playerId
          && d.playerName is string && d.playerName.size() > 0 && d.playerName.size() <= 30
          && d.score is int && d.score >= -1000 && d.score <= 100000
          && d.baseScore is int && d.baseScore >= -1000 && d.baseScore <= 100000
          && d.timeMs is int && d.timeMs >= 0 && d.timeMs <= 9999999
          && d.rankKey == d.score * 10000000 + (9999999 - d.timeMs)
          && d.mode is string && d.mode.size() <= 20
          && d.showInfo is bool
          && d.updatedAt == request.time
          && (
            (d.showInfo == false && d.keys().hasOnly(baseKeys()))
            || (d.showInfo == true
                && d.keys().hasOnly(baseKeys().concat(['age', 'school', 'city', 'picture']))
                && (d.age == null || (d.age is int && d.age >= 3 && d.age <= 99))
                && d.school is string && d.school.size() <= 40
                && d.city is string && d.city.size() <= 10
                && d.picture is string && d.picture.size() <= 500)
          );
      }

      allow create: if validData();

      // 成績只能不變或變好（總分更高，或總分相同但用時更短）
      allow update: if validData() && request.resource.data.rankKey >= resource.data.rankKey;
    }
  }
}
