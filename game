<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小動物躲貓貓 - 30關大挑戰豪華版</title>
    <!-- 引入彩帶特效庫 -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
        }
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
            font-family: 'Comic Sans MS', 'Microsoft JhengHei', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }
        .game-container {
            width: 100%;
            max-width: 850px;
            height: 100%;
            max-height: 980px;
            background: #ffffff;
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            border: 6px solid #fff;
        }
        .header {
            background: #4a90e2;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.2);
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 14px;
        }
        .sound-btn {
            background: #ffca28;
            border: none;
            padding: 6px 12px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            color: #d84315;
            box-shadow: 0 2px 0 #ffa000;
        }
        .sub-header {
            background: #fff8e1;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #ffe082;
            font-size: 16px;
        }
        .timer-container {
            width: 100%;
            height: 12px;
            background: #eee;
            position: relative;
        }
        .timer-bar {
            height: 100%;
            width: 100%;
            background: #66bb6a;
            transition: width 0.1s linear;
        }
        .mission-bar {
            background: #e1f5fe;
            color: #01579b;
            padding: 12px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            border-bottom: 3px dashed #b3e5fc;
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .mission-target {
            font-size: 28px;
            color: #e65100;
            margin-left: 8px;
        }
        .play-area {
            flex: 1;
            background: #f1f8e9;
            position: relative;
            display: grid;
            gap: 10px;
            padding: 20px;
            align-items: center;
            justify-items: center;
            overflow-y: auto;
        }
        /* 格子與圖標放大 4 倍 (字體從 28px 放大到 72px，方塊最低高度放大到 100px) */
        .spot {
            background: #8d6e63;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 6px 0 #5d4037;
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 100px;
        }
        .animal, .shelter {
            position: absolute;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 18px;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }
        .animal { font-size: 72px; z-index: 1; }
        .shelter {
            background: #ffb74d;
            z-index: 2;
            border: 4px solid #f57c00;
            font-size: 20px;
            color: #fff;
            font-weight: bold;
            box-shadow: inset 0 -6px 0 rgba(0,0,0,0.15);
        }
        .shelter.open {
            transform: translateY(-90px) scale(0.7);
            opacity: 0;
            pointer-events: none;
        }
        .message-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #fff;
            z-index: 10;
            padding: 20px;
            text-align: center;
        }
        .login-card {
            background: #fff;
            color: #333;
            padding: 30px;
            border-radius: 20px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        .login-card input {
            width: 100%;
            padding: 12px;
            font-size: 18px;
            margin: 15px 0;
            border: 2px solid #ccc;
            border-radius: 10px;
            text-align: center;
        }
        .google-btn {
            background: #4285F4;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 4px 0 #2a65c7;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .leaderboard-list {
            background: #fff;
            color: #333;
            width: 100%;
            max-width: 400px;
            border-radius: 10px;
            padding: 10px;
            margin: 10px 0;
            text-align: left;
            max-height: 180px;
            overflow-y: auto;
        }
        .leaderboard-item {
            display: flex;
            justify-content: space-between;
            padding: 6px 10px;
            border-bottom: 1px solid #eee;
            font-size: 16px;
        }
        .action-btn {
            margin-top: 15px;
            background: #ffca28;
            color: #d84315;
            border: none;
            padding: 12px 35px;
            font-size: 20px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 0 #ffa000;
        }
        .hidden { display: none !important; }
    </style>
</head>
<body>

    <div class="game-container">
        <div class="header">
            <div class="user-info" id="current-user-display">
                <span>👤 尚未登入</span>
            </div>
            <button class="sound-btn" id="sound-toggle-btn" onclick="toggleSound()">🔊 音效: 開</button>
        </div>

        <div class="sub-header">
            <span id="score-board">得分: 0</span>
            <span id="level-display" style="font-weight: bold; color: #d84315;">第 1 關</span>
        </div>

        <div class="timer-container">
            <div class="timer-bar" id="timer-bar"></div>
        </div>

        <div class="mission-bar" id="mission-bar">請先登入 Google 帳號開始遊戲！</div>

        <div class="play-area" id="play-area"></div>

        <div id="login-overlay" class="message-overlay">
            <div class="login-card">
                <h2>🐾 小動物躲貓貓 (30關版)</h2>
                <p style="color: #666; font-size: 15px;">請輸入玩家名稱或使用 Google 帳號登入紀錄成績：</p>
                <input type="text" id="player-name-input" placeholder="請輸入小朋友名字..." value="小寶貝">
                <button class="google-btn" onclick="loginWithGoogle()">
                    <span>🌐</span> 使用 Google 帳號快速登入
                </button>
            </div>
        </div>

        <div id="gameover-overlay" class="message-overlay hidden">
            <h1 id="over-title">遊戲結束</h1>
            <p id="over-desc" style="font-size: 18px; margin: 5px 0;">得分: 0</p>
            
            <h3 style="margin: 10px 0 5px 0; color: #ffca28;">🏆 全球英雄排行榜</h3>
            <div class="leaderboard-list" id="leaderboard-container"></div>

            <button class="action-btn" onclick="restartGame()">再玩一次！</button>
        </div>
    </div>

    <script>
        let playerName = "";
        let soundEnabled = true;
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('sound-toggle-btn').innerText = soundEnabled ? "🔊 音效: 開" : "🔇 音效: 關";
        }

        function playSound(type) {
            if (!soundEnabled) return;
            if (audioCtx.state === 'suspended') { audioCtx.resume(); }
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            const now = audioCtx.currentTime;
            if (type === 'correct') {
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.setValueAtTime(659.25, now + 0.1);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start(now); osc.stop(now + 0.3);
            } else if (type === 'wrong') {
                osc.frequency.setValueAtTime(200, now);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start(now); osc.stop(now + 0.3);
            }
        }

        function loginWithGoogle() {
            const inputName = document.getElementById('player-name-input').value.trim();
            if (!inputName) {
                alert('請輸入玩家名字！');
                return;
            }
            playerName = "Google 玩家: " + inputName;
            document.getElementById('current-user-display').innerHTML = `<span>👤 ${playerName}</span>`;
            document.getElementById('login-overlay').classList.add('hidden');
            startGame();
        }

        function getLeaderboard() {
            return JSON.parse(localStorage.getItem('animal_game_leaderboard')) || [
                { name: '小明 (爸爸陪玩)', score: 350 },
                { name: '晴晴', score: 240 },
                { name: '樂樂', score: 120 }
            ];
        }

        function saveScoreToLeaderboard(name, sc) {
            let lb = getLeaderboard();
            lb.push({ name: name, score: sc });
            lb.sort((a, b) => b.score - a.score);
            if (lb.length > 5) lb = lb.slice(0, 5);
            localStorage.setItem('animal_game_leaderboard', JSON.stringify(lb));
        }

        function renderLeaderboard() {
            let lb = getLeaderboard();
            const container = document.getElementById('leaderboard-container');
            container.innerHTML = lb.map((item, idx) => `
                <div class="leaderboard-item">
                    <span>${idx+1}. ${item.name}</span>
                    <span style="font-weight: bold; color: #e65100;">${item.score} 分</span>
                </div>
            `).join('');
        }

        // 超豐富的動物與圖標清單（超過 130 種，確保 30 關卡每一關的數量都夠抽）
        const allAnimals = [
