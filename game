            { name: '小星星', emoji: '🌟' }, { name: '小月亮', emoji: '🌙' },
            { name: '小太陽', emoji: '☀️' }, { name: '小雪花', emoji: '❄️' },
            { name: '小火焰', emoji: '🔥' }, { name: '小水滴', emoji: '💧' },
            { name: '小愛心', emoji: '❤️' }, { name: '小笑臉', emoji: '😊' },
            { name: '小機器人', emoji: '🤖' }, { name: '小外星人', emoji: '👽' },
            { name: '小幽靈', emoji: '👻' }, { name: '小南瓜', emoji: '🎃' },
            { name: '小城堡', emoji: '🏰' }, { name: '小帳篷', emoji: '⛺' },
            { name: '小汽車', emoji: '🚗' }, { name: '小火車', emoji: '🚂' },
            { name: '小飛機', emoji: '✈️' }, { name: '小輪船', emoji: '🚢' },
            { name: '小直升機', emoji: '🚁' }, { name: '小自行車', emoji: '🚲' }
        ];

        // 透過迴圈自動生成 30 個關卡：第 1 關 4 個，每關增加 4 個格子 (4, 8, 12, 16 ... 120)
        const levelConfig = [];
        for (let i = 1; i <= 30; i++) {
            let count = i * 4;
            let time = Math.min(15 + i * 3, 90); // 隨著關卡增加時間，上限 90 秒
            levelConfig.push({ level: i, count: count, time: time });
        }

        let currentLevelIndex = 0;
        let score = 0;
        let currentTarget = null;
        let gameActive = false;
        let spotElements = [];
        let timerInterval = null;
        let timeLeft = 0;

        function startGame() {
            currentLevelIndex = 0;
            score = 0;
            document.getElementById('score-board').innerText = `得分: ${score}`;
            startLevel();
        }

        function restartGame() {
            document.getElementById('gameover-overlay').classList.add('hidden');
            startGame();
        }

        function startLevel() {
            gameActive = false;
            clearInterval(timerInterval);
            const config = levelConfig[currentLevelIndex];
            document.getElementById('level-display').innerText = `第 ${config.level} 關 (${config.count}個)`;
            document.getElementById('mission-bar').innerHTML = `👀 記憶第 ${config.level} 關圖案位置...`;

            const playArea = document.getElementById('play-area');
            // 依照格子數量動態調整欄位排版
            if (config.count <= 4) playArea.style.gridTemplateColumns = 'repeat(2, 1fr)';
            else if (config.count <= 12) playArea.style.gridTemplateColumns = 'repeat(4, 1fr)';
            else if (config.count <= 24) playArea.style.gridTemplateColumns = 'repeat(6, 1fr)';
            else if (config.count <= 48) playArea.style.gridTemplateColumns = 'repeat(8, 1fr)';
            else playArea.style.gridTemplateColumns = 'repeat(10, 1fr)';

            playArea.innerHTML = '';
            spotElements = [];

            for (let i = 0; i < config.count; i++) {
                const spot = document.createElement('div');
                spot.classList.add('spot');
                const animalDiv = document.createElement('div');
                animalDiv.classList.add('animal');
                const shelterDiv = document.createElement('div');
                shelterDiv.classList.add('shelter');
                shelterDiv.innerText = `🏠`;

                spot.appendChild(animalDiv);
                spot.appendChild(shelterDiv);
                spot.addEventListener('click', () => handleSpotClick(i));
                playArea.appendChild(spot);
                spotElements.push({ animalDiv, shelterDiv });
            }

            const shuffled = [...allAnimals].sort(() => 0.5 - Math.random()).slice(0, config.count);
            spotElements.forEach((item, idx) => {
                item.animalDiv.innerText = shuffled[idx].emoji;
                item.animalDiv.dataset.name = shuffled[idx].name;
                item.shelterDiv.classList.add('open');
            });

            // 記憶時間隨著關卡格子增加而稍微拉長
            let memoryTime = 2000 + config.count * 40;

            setTimeout(() => {
                spotElements.forEach(item => item.shelterDiv.classList.remove('open'));
                const targetObj = shuffled[Math.floor(Math.random() * config.count)];
                currentTarget = targetObj.name;
                document.getElementById('mission-bar').innerHTML = `🎯 請找出：<span class="mission-target">${targetObj.emoji} ${targetObj.name}</span>`;
                gameActive = true;

                let totalT = config.time;
                timeLeft = totalT;
                const timerBar = document.getElementById('timer-bar');
                timerInterval = setInterval(() => {
                    timeLeft -= 0.1;
                    let pct = (timeLeft / totalT) * 100;
                    if (pct < 0) pct = 0;
                    timerBar.style.width = `${pct}%`;
                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        gameOver("時間到！");
                    }
                }, 100);
            }, memoryTime);
        }

        function handleSpotClick(idx) {
            if (!gameActive) return;
            const clicked = spotElements[idx].animalDiv.dataset.name;
            spotElements[idx].shelterDiv.classList.add('open');

            if (clicked === currentTarget) {
                gameActive = false;
                clearInterval(timerInterval);
                playSound('correct');
                score += (currentLevelIndex + 1) * 10; // 關卡越後面答對分數越高
                document.getElementById('score-board').innerText = `得分: ${score}`;
                confetti({ particleCount: 50, spread: 60, origin: { y: 0.6 } });

                setTimeout(() => {
                    currentLevelIndex++;
                    if (currentLevelIndex >= levelConfig.length) {
                        gameOver("🎉 太神啦！通關全部 30 關大滿貫！");
                    } else {
                        startLevel();
                    }
                }, 1200);
            } else {
                playSound('wrong');
                document.getElementById('mission-bar').innerHTML = `❌ 這是 ${clicked}，再找找看！`;
                setTimeout(() => {
                    if (gameActive) spotElements[idx].shelterDiv.classList.remove('open');
                }, 800);
            }
        }

        function gameOver(msg) {
            gameActive = false;
            clearInterval(timerInterval);
            saveScoreToLeaderboard(playerName, score);
            renderLeaderboard();

            document.getElementById('over-title').innerText = msg;
            document.getElementById('over-desc').innerText = `玩家: ${playerName} | 最終得分: ${score} 分`;
            document.getElementById('gameover-overlay').classList.remove('hidden');
        }
    </script>
</body>
</html>
